@model BookSessionViewModel

@{
    ViewData["Title"] = "Book Member";
}

<div class="container mt-4">
    <partial name="_TempDataAlert" />

    <header class="mb-4">
        <h3 class="text-primary-color">Book Member in Session</h3>
        <p class="text-muted">Enroll a member into this scheduled training session</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <!-- Session Summary Card -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <h5 class="text-primary-color mb-3">
                            <i class="bi bi-calendar-event me-2"></i>@Model.CategoryName Session
                        </h5>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <small class="text-muted d-block">Trainer</small>
                                <span class="fw-bold">@Model.TrainerName</span>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Schedule</small>
                                <span class="fw-bold">@Model.DateDisplay (@Model.TimeRangeDisplay)</span>
                            </div>
                            <div class="col-12 mt-2">
                                <span class="badge bg-success">@Model.AvailableSlots Available Slots Left</span>
                            </div>
                        </div>
                    </div>

                    <form asp-controller="SessionSchedule" asp-action="Book" method="post">
                        <input type="hidden" asp-for="SessionId" />
                        <input type="hidden" asp-for="CategoryName" />
                        <input type="hidden" asp-for="TrainerName" />
                        <input type="hidden" asp-for="DateDisplay" />
                        <input type="hidden" asp-for="TimeRangeDisplay" />
                        <input type="hidden" asp-for="AvailableSlots" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Select Member</h5>
                            <hr class="mt-2">
                        </div>

                        <div class="mb-4">
                            <label asp-for="MemberId" class="form-label fw-semibold">
                                Member <span class="text-danger">*</span>
                            </label>
                            <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                                <option value="">-- Choose Member --</option>
                            </select>
                            <span asp-validation-for="MemberId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-controller="SessionSchedule" asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>Back to Schedule
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>Confirm Booking
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertDismissScript" />
}
