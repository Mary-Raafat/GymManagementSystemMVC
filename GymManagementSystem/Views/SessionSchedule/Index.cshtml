@model IEnumerable<SessionScheduleViewModel>

@{
    ViewData["Title"] = "Sessions Schedule";
}

<div class="container">
    <partial name="_TempDataAlert" />

    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
        <div>
            <h2 class="text-primary-color mb-0">Training Schedule & Bookings</h2>
            <p class="text-muted">View upcoming sessions, book members, and manage attendance</p>
        </div>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 session-card">
                        <div class="card-header text-white py-3 @(session.Status == "Ongoing" ? "bg-success" : session.Status == "Upcoming" ? "bg-primary-color" : "bg-secondary")">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-calendar-event me-2"></i>@session.CategoryName
                                </h5>
                                <span class="badge bg-light text-dark">@session.Status</span>
                            </div>
                        </div>

                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>

                            <div class="session-info mb-3">
                                <div class="info-item mb-2">
                                    <i class="bi bi-person-circle text-primary-color me-2"></i>
                                    <strong>Trainer:</strong> @session.TrainerName
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-calendar3 text-primary-color me-2"></i>
                                    <strong>Date:</strong> @session.DateDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-clock text-primary-color me-2"></i>
                                    <strong>Time:</strong> @session.TimeRangeDisplay
                                </div>
                                <div class="info-item">
                                    <i class="bi bi-people text-primary-color me-2"></i>
                                    <strong>Availability:</strong>
                                    @if (session.IsFull)
                                    {
                                        <span class="badge bg-danger">Full (@session.Capacity/@session.Capacity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@session.AvailableSlots slots left</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3">
                            <div class="d-grid gap-2">
                                @if (session.CanBook)
                                {
                                    <a asp-controller="SessionSchedule" asp-action="Book" asp-route-sessionId="@session.SessionId" class="btn btn-fill btn-sm">
                                        <i class="bi bi-person-plus me-1"></i>Book Member
                                    </a>
                                }
                                else if (session.IsFull)
                                {
                                    <button class="btn btn-outline btn-sm" disabled>
                                        <i class="bi bi-slash-circle me-1"></i>Session Full
                                    </button>
                                }

                                <a asp-controller="SessionSchedule" asp-action="Attendance" asp-route-sessionId="@session.SessionId" class="btn btn-outline btn-sm">
                                    <i class="bi bi-card-checklist me-1"></i>Attendees (@session.BookedCount)
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Scheduled Sessions</h4>
            <p class="text-muted">Create training sessions from the Sessions tab to view them here</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertDismissScript" />
}
