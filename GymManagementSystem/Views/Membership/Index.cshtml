@model IEnumerable<MembershipViewModel>

@{
    ViewData["Title"] = "Memberships";
}

<div class="container">
    <partial name="_TempDataAlert" />

    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
        <div>
            <h2 class="text-primary-color mb-0">Active Memberships</h2>
            <p class="text-muted">Manage member subscriptions and plan assignments</p>
        </div>
        <a asp-controller="Membership" asp-action="Create" class="btn btn-fill fw-medium rounded-pill px-4 py-3">
            <i class="bi bi-plus-lg me-2"></i>Assign Membership
        </a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive" style="overflow: visible;">
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th><span>Member</span></th>
                        <th><span>Phone</span></th>
                        <th><span>Plan</span></th>
                        <th><span>Price</span></th>
                        <th><span>Start Date</span></th>
                        <th><span>End Date</span></th>
                        <th><span>Status</span></th>
                        <th><span>Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-bold">@item.MemberName</span></td>
                            <td><span>@item.MemberPhone</span></td>
                            <td><span class="badge bg-primary-color">@item.PlanName</span></td>
                            <td><span class="fw-bold text-primary-color">@item.PlanPrice.ToString("N0") EGP</span></td>
                            <td><span>@item.StartDateDisplay</span></td>
                            <td><span>@item.EndDateDisplay</span></td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">Active (@item.DaysRemaining days left)</span>
                                }
                                else if (item.Status == "Upcoming")
                                {
                                    <span class="badge bg-primary">Upcoming</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Expired</span>
                                }
                            </td>
                            <td>
                                <form asp-controller="Membership" asp-action="Cancel" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this membership?');">
                                    <button type="submit" class="btn btn-outline btn-sm text-danger">
                                        <i class="bi bi-x-circle me-1"></i>Cancel
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-card-checklist display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Memberships Available</h4>
            <p class="text-muted">Assign a membership plan to a member to get started</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertDismissScript" />
}
