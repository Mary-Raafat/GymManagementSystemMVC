@model CreateMembershipViewModel

@{
    ViewData["Title"] = "Assign Membership";
}

<div class="container mt-4">
    <partial name="_TempDataAlert" />

    <header class="mb-4">
        <h3 class="text-primary-color">Assign Membership</h3>
        <p class="text-muted">Subscribe a member to a membership package</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-controller="Membership" asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Membership Details</h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="MemberId" class="form-label fw-semibold">
                                    Member <span class="text-danger">*</span>
                                </label>
                                <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                                    <option value="">-- Select Member --</option>
                                </select>
                                <span asp-validation-for="MemberId" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="PlanId" class="form-label fw-semibold">
                                    Membership Plan <span class="text-danger">*</span>
                                </label>
                                <select asp-for="PlanId" asp-items="ViewBag.Plans" class="form-select">
                                    <option value="">-- Select Plan --</option>
                                </select>
                                <span asp-validation-for="PlanId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">
                                    Start Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-controller="Membership" asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>Assign Plan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertDismissScript" />
}
