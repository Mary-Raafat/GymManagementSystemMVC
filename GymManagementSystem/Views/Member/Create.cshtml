@{
    ViewData["Title"] = "Add Member";
}

@model CreateMemberViewModel

<div class="container">
    <main role="main" class="pb-3">

        <header class="mb-4">
            <h3 class="text-primary-color">Add Member</h3>
        </header>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Personal Information -->
            <div class="section-header mb-3">
                <h5 class="text-primary fw-bold">Personal Information</h5>
                <hr class="mt-2">
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="DateOfBirth" class="form-label">DateOfBirth</label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Gender" class="form-label">Gender</label>
                    <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
            </div>

            <!-- Address Information -->
            <div class="section-header mb-3 mt-4">
                <h5 class="text-primary fw-bold">Address Information</h5>
                <hr class="mt-2">
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="BuildingNumber" class="form-label">BuildingNumber</label>
                    <input asp-for="BuildingNumber" class="form-control" />
                    <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Street" class="form-label">Street</label>
                    <input asp-for="Street" class="form-control" />
                    <span asp-validation-for="Street" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="City" class="form-label">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>

            <!-- Health Information -->
            <div class="section-header mb-3 mt-4">
                <h5 class="text-primary fw-bold">Health Information</h5>
                <hr class="mt-2">
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="HealthRecordViewModel.Height" class="form-label">Height</label>
                    <input type="number" asp-for="HealthRecordViewModel.Height" class="form-control" />
                    <span asp-validation-for="HealthRecordViewModel.Height" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="HealthRecordViewModel.Weight" class="form-label">Weight</label>
                    <input  type="number" asp-for="HealthRecordViewModel.Weight" class="form-control" />
                    <span asp-validation-for="HealthRecordViewModel.Weight" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="HealthRecordViewModel.BloodType" class="form-label">Blood Type</label>
                    <select asp-for="HealthRecordViewModel.BloodType" asp-items="Html.GetEnumSelectList<BloodType>()" class="form-select">
                    </select>
                    <span asp-validation-for="HealthRecordViewModel.BloodType" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="HealthRecordViewModel.Note" class="form-label">Note</label>
                    <input asp-for="HealthRecordViewModel.Note" class="form-control" />
                    <span asp-validation-for="HealthRecordViewModel.Note" class="text-danger"></span>
                </div>
            </div>

            <footer class="d-flex justify-content-end gap-3 mt-4">
                <a asp-controller="Member" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i> Back to List
                </a>

                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-plus-circle me-2"></i> Add
                </button>
            </footer>

        </form>

    </main>
</div>



            @section Scripts{
    <partial name="_ValidationScriptsPartial" />
            }