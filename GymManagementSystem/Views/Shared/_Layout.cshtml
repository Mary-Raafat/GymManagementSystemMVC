<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- ^ Bootstrap 5.3.8 css file -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- ^ Our main css file -->
    <link rel="stylesheet" href="~/css/style.css" />
    <title>@ViewData["Title"] - Power fitness</title>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg bg-white my-3">
            <div class="container">
                <a class="navbar-brand" href="#">
                    <img src="~/images/logo.jpg" alt="" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var menuItems = new List<(string Controller, string Action, string Text, string Url)>
                        {
                            ("Home", "Index", "Home", ""),
                            ("Member", "Index", "Members", ""),
                            ("Trainer", "", "Trainers", "#"),
                            ("Session", "", "Sessions", "#"),
                            ("Plans", "Index", "Plans", ""),
                            ("Membership", "", "Memberships", "#"),
                            ("SessionSchedule", "", "Sessions Schedule", "#")
                        };
                    }
                    <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">
                        @foreach (var (controller, action, text, url) in menuItems)
                        {
                            var isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
                            <li class="nav-item">
                                @if (string.IsNullOrEmpty(url))
                                {
                                    <a class="nav-link @(isActive ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5" 
                                       asp-controller="@controller" asp-action="@action"
                                       aria-current="@(isActive ? "page" : null)">@text</a>
                                }
                                else
                                {
                                    <a class="nav-link @(isActive ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5" 
                                       href="@url"
                                       aria-current="@(isActive ? "page" : null)">@text</a>
                                }
                            </li>
                        }
                        <li class="nav-item">
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                                <button type="submit"
                                        class="btn btn-link nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative">
                                    Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()  @*  بيرحع ال  body بتاع الفيو بتاعك*@
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GymManagementSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>




