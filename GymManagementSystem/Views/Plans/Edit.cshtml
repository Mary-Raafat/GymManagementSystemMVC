@model EditPlanViewModel

@{
    ViewData["Title"] = "Edit Plan";
}

<div class="container mt-4">
    <partial name="_TempDataAlert" />

    <header class="mb-4">
        <h3 class="text-primary-color">Edit Plan</h3>
        <p class="text-muted">Update membership plan pricing and details</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="mb-4 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Editing Plan</small>
                        <h4 class="mb-0 text-black">@Model.Name Plan</h4>
                    </div>

                    <form asp-controller="Plans" asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Name" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">Plan Information</h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Description <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DurationDays" class="form-label fw-semibold">
                                    Duration in Days (1-365) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DurationDays" type="number" min="1" max="365" class="form-control" />
                                <span asp-validation-for="DurationDays" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold">
                                    Price (EGP) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-controller="Plans" asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>Update Plan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertDismissScript" />
}
