@model SessionDetailsViewModel

@{
    ViewData["Title"] = "Delete Session";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4 shadow-sm border-0 text-center">
                <div class="mb-3 text-danger">
                    <i class="bi bi-exclamation-triangle display-3"></i>
                </div>

                <h3 class="text-primary-color mb-3">Delete Training Session</h3>
                <p class="text-muted">Are you sure you want to delete this session?</p>

                <div class="card bg-light border-0 p-3 mb-4 text-start">
                    <div class="row g-2">
                        <div class="col-6">
                            <small class="text-muted d-block">Category</small>
                            <span class="fw-bold">@Model.CategoryName</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Trainer</small>
                            <span class="fw-bold">@Model.TrainerName</span>
                        </div>
                        <div class="col-12">
                            <small class="text-muted d-block">Schedule</small>
                            <span class="fw-bold">@Model.StartDate &rarr; @Model.EndDate</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Capacity</small>
                            <span>@Model.Capacity slots</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Bookings</small>
                            <span class="@(Model.BookedSlots > 0 ? "text-danger fw-bold" : "text-muted")">@Model.BookedSlots Booked</span>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning text-start" role="alert">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Warning!</strong> Sessions with active bookings cannot be deleted.
                </div>

                <form asp-controller="Session" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="mt-3">
                    <div class="d-flex justify-content-between gap-3">
                        <a asp-controller="Session" asp-action="Index" class="btn btn-outline flex-fill">
                            <i class="bi bi-arrow-left me-1"></i>No, Cancel
                        </a>
                        <button type="submit" class="btn btn-danger flex-fill">
                            <i class="bi bi-trash me-1"></i>Yes, Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_AlertDismissScript" />
}